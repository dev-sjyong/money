{
  "name": "household-ledger",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.1",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "node --import tsx --test tests/accounting.test.ts",
    "test:db": "bash tests/run-db.sh",
    "test:ui": "playwright test",
    "format": "prettier --write app tests/browser tests/accounting.test.ts *.ts *.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "nuxt": "^4.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.0.0"
  }
}
